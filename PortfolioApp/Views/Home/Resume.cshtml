@section Scripts {
    <script>
        $(document).ready(function () {
            // Yüzdelik barları veri özelliğine (data-percent) göre animasyonlu doldur
            $('.bar').each(function () {
                var bar = $(this);
                var percent = bar.attr('data-percent');
                
                // Arka planı garantilemek için CSS uygulayıp, ardından genişliği animasyonla veriyoruz
                bar.css({
                    'position': 'relative',
                    'width': '100%',
                    'height': '6px',
                    'background': '#eeeeee',
                    'margin-top': '8px'
                });

                var progress = bar.find('.progress');
                progress.css({
                    'position': 'absolute',
                    'top': '0',
                    'left': '0',
                    'height': '100%',
                    'background': '#2BBE8D', // Tema yeşili
                    'width': '0' // Başlangıçta sıfır
                }).animate({
                    width: percent + '%'
                }, 1500); // 1.5 saniyede dolma animasyonu
            });
        });
    </script>
}