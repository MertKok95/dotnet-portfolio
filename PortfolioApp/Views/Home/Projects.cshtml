@model List<PortfolioApp.Models.Project>

@{
    Layout = "_Layout";
    ViewData["Title"] = "MERT KOK - PORTFOLIO";
}

<!-- site-main -->
<div id="main" class="site-main">
    <div class="layout-medium">
        <div id="primary" class="content-area">
             
            <!-- site-content -->
            <div id="content" class="site-content" role="main"> <!-- .hentry -->
                <article class="hentry post single-post format-gallery">
                    <!-- .entry-header -->
                    <header class="entry-header">
                        <!-- .entry-title -->
                        <h1 class="entry-title">Portfolio</h1>
                    </header>
                    <!-- .entry-header -->
                                                      
                    <!-- .entry-content -->
                    <div class="entry-content">
                                    
                        <!-- .gallery -->
                        <div class="gallery link-to-file">

                            @foreach (Project item in Model)
                            {
                                <figure class="gallery-item">
                                    <div class="gallery-icon landscape">
                                        <a href="@item.ImageUrl">
                                            <img src="@item.ImageUrl" class="attachment-thumbnail" alt="@item.Title">
                                        </a>
                                    </div>
        
                                    <figcaption class="wp-caption-text gallery-caption">
                                        <strong class="mfp-proj-title">@item.Title</strong><br />
                                        <span class="mfp-proj-tech" style="font-size: 10px; opacity: 0.8;">[ @item.TechStack
                                            ]</span>
            
                                            <span class="mfp-proj-desc" style="display: none;"> <br /><br /> @item.Description
                                            </span>
                                        </figcaption>
                                    </figure>
                                }
                            </div>
                            <!-- .gallery -->
                        </div>
                        <!-- .entry-content -->
                    </article>
                    <!-- .hentry -->
                </div>
                <!-- site-content -->
            </div>
            <!-- primary -->
        </div>
        <!-- layout -->
    </div>
    <!-- site-main -->
        