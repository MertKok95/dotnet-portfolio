@model List<PortfolioApp.Models.Project>
@{ ViewData["Title"] = "MERT KOK - PORTFOLIO"; }

<h2 class="mb-4 fw-bold">MERT KOK - PORTFOLIO</h2>
<div class="row">
    @foreach(var item in Model)
    {
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0 bg-light">

                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;">
                }

                <div class="card-body">
                    <h5 class="card-title fw-bold">@item.Title</h5>
                    <h6 class="card-subtitle mb-3 text-primary">@item.TechStack</h6>
                    <p class="card-text">@item.Description</p>

                    @if (!string.IsNullOrEmpty(item.GitHubUrl))
                    {
                        <a href="@item.GitHubUrl" target="_blank" class="btn btn-dark btn-sm">View on GitHub</a>
                    }
                </div>
            </div>
        </div>
    }
</div>